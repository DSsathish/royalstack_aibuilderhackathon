ENV=dev
GOOGLE_CLOUD_PROJECT=royastacxk-aibuildercup
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_LOCATION=global
# GEMINI_API_KEY=            # only if GOOGLE_GENAI_USE_VERTEXAI=false
# INVENTORY_SHEET_TEMPLATE_URL=   # a Google Sheets copy of the inventory template (its /copy link); the Inventory tab shows the Sheets button only when set
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_LIVE_MODEL=gemini-live-2.5-flash
CORS_ORIGINS=["http://localhost:3000"]
QR_SESSION_SIGNING_KEY=change-me-64-random-bytes
APP_BASE_URL=http://localhost:3000
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
